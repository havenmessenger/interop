#!/bin/sh
set -e

# Dedicated, unprivileged system account this daemon runs as. Idempotent: does nothing if it
# already exists (e.g. on upgrade). systemd's StateDirectory= directive in the shipped unit
# creates /var/lib/mimihubd at the right owner/mode on every service start - this script only
# needs to make sure the account itself exists first.
if ! getent passwd mimihubd >/dev/null; then
    adduser --system --group --no-create-home --home /var/lib/mimihubd \
        --shell /usr/sbin/nologin --disabled-login \
        --gecos "mimihubd reference MIMI hub daemon" mimihubd
fi

# /etc/mimihubd, unlike /var/lib/mimihubd, is created by dpkg itself (to place the two .example
# files below it) at dpkg's own default directory mode, not by systemd's ConfigurationDirectory=
# directive - that directive only sets the mode when IT creates the directory, and does nothing
# if the directory already exists. Verified empirically on a genuinely fresh install: dpkg leaves
# the directory root:root, and a chmod-only fix (no chown) leaves it 0750 root:root - the daemon
# runs as mimihubd:mimihubd, which is in neither the owning user NOR the owning group, so it has
# ZERO access to its own config directory (a hard failure, not a cosmetic warning: the daemon
# cannot read its cert/key paths or any config file placed here). This directory ends up holding
# the daemon's mTLS private key material, so root:mimihubd 0750 (root read/write, daemon group
# read+traverse, no world access) is both correct and sufficient - the daemon user is a MEMBER of
# the mimihubd group created above, not the mimihubd user's own primary ownership.
chown root:mimihubd /etc/mimihubd
chmod 0750 /etc/mimihubd

#DEBHELPER#

exit 0
