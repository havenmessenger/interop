# Optional env-var overrides, loaded by the packaged systemd unit via EnvironmentFile=- (the
# leading "-" means this file is not required to exist). Anything set here overrides the matching
# key in /etc/mimihubd/mimihubd.toml. Useful for pinning one setting (e.g. MIMI_BIND_ADDR in a
# container) without maintaining two config files, or for running purely on env vars: copy this
# file to /etc/mimihubd/mimihubd.env, set every value below, and edit the unit's ExecStart= to
# drop --config entirely (systemctl edit mimihubd) for the original env-only interface.
#
# MIMI_PROVIDER_DOMAIN=hub.example.org
# MIMI_BIND_ADDR=0.0.0.0:8443
# MIMI_DB_PATH=/var/lib/mimihubd/hub.db
# MIMI_SERVER_CERT=/etc/mimihubd/server-cert.pem
# MIMI_SERVER_KEY=/etc/mimihubd/server-key.pem
# MIMI_CLIENT_CA=/etc/mimihubd/ca-cert.pem
# MIMI_PUBLIC_BASE_URL=https://mimi.hub.example.org:8443
